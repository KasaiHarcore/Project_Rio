# ==============================================================================
# Project Rio — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ── LLM API Keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-your-key-here
TAVILY_API_KEY=tvly-your-key-here
COHERE_API_KEY=your-cohere-key-here

# ── Security / Auth ───────────────────────────────────────────────────────────
# Generate JWT secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-random-hex-string
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=private.pem
JWT_PUBLIC_KEY=public.pem

# Generate Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ── OAuth2 (optional) ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# For local Windows dev (WSL bridge IP):
LOCAL_POSTGRES_WIN_HOST=localhost
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=postgres
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=your-postgres-password

# Or set DATABASE_URL directly (overrides the above):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# ── Neo4j (optional) ─────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Arize Phoenix Tracing (optional) ─────────────────────────────────────────
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=project-rio
